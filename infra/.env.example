# Local Docker defaults for Sophia stack

# PostgreSQL (used by scrivener + sophia_canvas)
POSTGRES_DB=sophia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Supabase pooler password (set this when using Supabase)
SUPABASE_DB_PASSWORD=

# Override application DB URLs only if you need custom values.
DATABASE_URL=postgresql://postgres.ftusifbgdewdouptknkn:${SUPABASE_DB_PASSWORD}@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# CANVAS_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sophia

# Optional API keys for scrivener data sources
FRED_API_KEY=
BLS_API_KEY=

# Canvas auth is disabled by default for local development
CANVAS_AUTH_ENABLED=false

# Dashboard host port
DASHBOARD_PORT=13000

# API/service host ports
SCRIVENER_PORT=8000
ARITHMOS_PORT=8001
KAMPE_PORT=8002
CANVAS_PORT=8003

# Gateway host port
GATEWAY_PORT=18080

# Optional LLM + channel settings for sophia_gateway
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
PERSONALITY_PATH=/workspace/agents/sophia_prima/config/personality.md
SOUL_PATH=/workspace/agents/sophia_prima/config/soul.md
LESSONS_PATH=/workspace/agents/sophia_prima/config/LESSONS.md
AGENT_FS_ENFORCE_WRITE_POLICY=true
AGENT_FS_WRITE_ALLOWLIST=.sophia
AGENT_FS_ENFORCE_READ_POLICY=true
AGENT_FS_READ_ALLOWLIST=config,skills,.sophia
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_ENABLED=true

# Optional multi-bot Telegram config (JSON list)
# TELEGRAM_ACCOUNTS_JSON=[{"account_id":"default","bot_token":"123:abc"}]

# Optional deterministic bindings (first-match, JSON list)
# GATEWAY_BINDINGS_JSON=[{"channel":"telegram","account_id":"default","peer_id":"12345","agent_id":"sophia_prima","session_id":"tg:default:12345"}]
