# Local Docker defaults for Sophia stack

# PostgreSQL (used by scrivener + sophia_canvas)
POSTGRES_DB=sophia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Supabase pooler password (set this when using Supabase)
SUPABASE_DB_PASSWORD=

# Local Docker defaults use the compose Postgres service.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sophia
# CANVAS_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sophia
# For Supabase or another hosted DB, override DATABASE_URL in infra/.env.
# DATABASE_URL=postgresql://postgres.<project_ref>:${SUPABASE_DB_PASSWORD}@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Optional API keys for scrivener data sources
FRED_API_KEY=
BLS_API_KEY=

# Canvas auth is disabled by default for local development
CANVAS_AUTH_ENABLED=false

# Dashboard host port
DASHBOARD_PORT=13000

# API/service host ports
SCRIVENER_PORT=8000
ARITHMOS_PORT=8001
KAMPE_PORT=8002
CANVAS_PORT=8003
THOLOS_PORT=8004
OIKONOMIA_PORT=8006

# Research corpus directory mounted into sophia_tholos as /corpus (read-only)
RESEARCH_CORPUS_PATH=../../research-store/distill_out
THOLOS_MODEL_NAME=all-MiniLM-L6-v2
# Keep semantic enabled for full-quality search. For faster local rebuilds, set both of these to false.
THOLOS_INSTALL_SEMANTIC=true
THOLOS_SEMANTIC_ENABLED=true
# Optional startup verification / model preload controls for semantic mode.
THOLOS_PRELOAD_MODEL=false
THOLOS_SEMANTIC_VERIFY_ON_STARTUP=false
THOLOS_SEMANTIC_STRICT=false
THOLOS_SEMANTIC_LOCAL_FILES_ONLY=true
THOLOS_MODEL_CACHE_DIR=/models/sentence-transformers

# Optional Brave Search API access for live web tools in Pylon
BRAVE_API_KEY=
BRAVE_BASE_URL=https://api.search.brave.com

# Fed Textual Change Tracker (external local-only service)
FED_TRACKER_URL=http://127.0.0.1:8005

# Optional Readwise CLI access for Reader documents and highlights
READWISE_CLI_PATH=readwise
READWISE_CLI_CONFIG_PATH=/root/.readwise-cli.json

# Pylon MCP host publish address (Docker host bind for port 8091).
# Local-only (default): Hermes on the same machine uses http://localhost:8091/mcp
PYLON_MCP_BIND_ADDRESS=127.0.0.1
# Tailscale / private-network profile: Hermes on another machine on the same
# Tailscale network. After changing this, recreate the MCP container
# (`docker compose up -d sophia_pylon_mcp` from infra/, or `make up`).
# Hermes URL: http://<sophia-magicdns-or-100.x>:8091/mcp
# Do NOT port-forward 8091 on your router. Prefer Tailscale ACLs / no public exposure.
# PYLON_MCP_BIND_ADDRESS=0.0.0.0
PYLON_MCP_PORT=8091
PYLON_MCP_PATH=/mcp
PYLON_TOOL_TIMEOUT_SEC=30
PYLON_MAX_CONCURRENCY_PER_SERVICE=8
