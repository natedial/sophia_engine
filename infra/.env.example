# Local Docker defaults for Sophia stack

# PostgreSQL (used by scrivener + sophia_canvas)
POSTGRES_DB=sophia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Supabase pooler password (set this when using Supabase)
SUPABASE_DB_PASSWORD=

# Override application DB URLs only if you need custom values.
DATABASE_URL=postgresql://postgres.ftusifbgdewdouptknkn:${SUPABASE_DB_PASSWORD}@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# CANVAS_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sophia

# Optional API keys for scrivener data sources
FRED_API_KEY=
BLS_API_KEY=

# Canvas auth is disabled by default for local development
CANVAS_AUTH_ENABLED=false

# Dashboard host port
DASHBOARD_PORT=13000

# API/service host ports
SCRIVENER_PORT=8000
ARITHMOS_PORT=8001
KAMPE_PORT=8002
CANVAS_PORT=8003
THOLOS_PORT=8004

# Research corpus directory mounted into sophia_tholos as /corpus (read-only)
RESEARCH_CORPUS_PATH=../../research-store/distill_out

# Fed Textual Change Tracker (external local-only service)
FED_TRACKER_URL=http://127.0.0.1:8005

# Gateway host port
GATEWAY_PORT=18080

# Optional LLM + channel settings for sophia_gateway
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
ANTHROPIC_API_KEY=
PERSONALITY_PATH=/workspace/agents/sophia_prima/config/personality.md
SOUL_PATH=/workspace/agents/sophia_prima/config/soul.md
LESSONS_PATH=/workspace/agents/sophia_prima/config/LESSONS.md
AGENT_FS_ENFORCE_WRITE_POLICY=true
AGENT_FS_WRITE_ALLOWLIST=.sophia
AGENT_FS_ENFORCE_READ_POLICY=true
AGENT_FS_READ_ALLOWLIST=config,skills,.sophia
CODING_WORKER_ENABLED=false
CODING_WORKER_BACKEND=codex
CODING_WORKER_WORKSPACE_ROOT=/workspace
CODING_WORKER_OUTPUT_DIR=/workspace/.sophia/coding_worker
CODING_RUNTIME_MODE=inline
# To route coding runs through Sophia Forge in dev/staging:
# CODING_RUNTIME_MODE=forge_service
# FORGE_BASE_URL=http://host.docker.internal:8090
# FORGE_REQUEST_TIMEOUT_SEC=30
CODEX_COMMAND=codex
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_MODEL=
CLAUDE_CODE_MAX_TURNS=8
CLAUDE_CODE_PERMISSION_MODE=acceptEdits
CLAUDE_CODE_ALLOWED_TOOLS=Bash,Edit,Glob,Grep,LS,MultiEdit,Read,Write
HISTORY_ENABLED=false
HISTORY_STORE_PATH=/workspace/.sophia/history.db
HISTORY_TOOL_RESULT_MAX_CHARS=50000

# Legacy Codex-only env names still supported:
# DEV_WORKER_ENABLED=false
# DEV_WORKER_CODEX_COMMAND=codex
# DEV_WORKER_MODEL=
# DEV_WORKER_CODEX_SANDBOX=workspace-write
# DEV_WORKER_WORKSPACE_ROOT=/workspace
# DEV_WORKER_OUTPUT_DIR=/workspace/.sophia/dev_worker
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_ENABLED=true

# Optional multi-bot Telegram config (JSON list)
# TELEGRAM_ACCOUNTS_JSON=[{"account_id":"default","bot_token":"123:abc"}]

# Optional deterministic bindings (first-match, JSON list)
# GATEWAY_BINDINGS_JSON=[{"channel":"telegram","account_id":"default","peer_id":"12345","agent_id":"sophia_prima","session_id":"tg:default:12345"}]
